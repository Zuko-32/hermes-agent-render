# ==============================================================
# HERMES AGENT CONFIGURATION / CONFIGURACIÓN DE HERMES AGENT
# ==============================================================

# [EN] 1. Your OpenRouter API Key (Get it from https://openrouter.ai/keys)
# [ES] 1. Tu clave de OpenRouter (Obtenida en https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [EN] 2. Default Free Model (:free tag ensures $0.00 cost)
# [ES] 2. Modelo Gratuito por Defecto (:free asegura coste 0.00€)
# Options / Opciones:
# - meta-llama/llama-3.3-70b-instruct:free (Recommended / Recomendado)
# - google/gemini-2.0-flash-lite:free (Ultra fast / Rápido)
# - deepseek/deepseek-r1:free (Reasoning / Razonamiento)
# - qwen/qwen-2.5-coder-32b-instruct:free (Coding / Código)
# - openrouter/free (Auto router / Enrutador inteligente)
MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free

# [EN] 3. Render Web Server Settings
# [ES] 3. Configuración del Servidor Web en Render
PORT=10000
API_SERVER_ENABLED=true
API_SERVER_PORT=10000
API_SERVER_KEY=secret_hermes_password_2026

# [EN] 4. Telegram Integration (Optional / Opcional)
# Bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# Your numeric Telegram user ID from @userinfobot
TELEGRAM_ALLOWED_USERS=123456789
